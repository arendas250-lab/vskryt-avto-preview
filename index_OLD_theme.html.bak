<style>
.asvc{margin:34px 0 10px;}
.asvc-hero{background:linear-gradient(120deg,#151d2a 0%,#25313f 60%,#3a2412 100%);border-radius:18px;padding:26px 28px;display:flex;align-items:center;justify-content:space-between;gap:20px;overflow:hidden;position:relative;}
.asvc-hero h2{color:#fff;font-size:27px;line-height:1.2;margin:0 0 10px;}
.asvc-hero h2 b{color:#ff6a00;}
.asvc-hero p{color:#c7cfda;margin:0 0 16px;font-size:15px;}
.asvc-cta{display:inline-block;background:#ff6a00;color:#fff!important;font-weight:700;padding:13px 24px;border-radius:10px;text-decoration:none;box-shadow:0 8px 20px rgba(255,106,0,.35);transition:.2s;}
.asvc-cta:hover{background:#ff8321;transform:translateY(-2px);}
.asvc-carwrap{flex:0 0 auto;color:#ff6a00;opacity:.95;}
.asvc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:16px;margin-top:20px;}
.asvc-card{display:flex;flex-direction:column;align-items:flex-start;background:#fff;border:1px solid #eceff3;border-radius:14px;padding:20px 18px;text-decoration:none!important;transition:.2s;box-shadow:0 2px 6px rgba(20,29,42,.04);}
.asvc-card:hover{border-color:#ff6a00;transform:translateY(-4px);box-shadow:0 14px 30px rgba(255,106,0,.15);}
.asvc-ic{width:52px;height:52px;border-radius:12px;background:#fff2e8;color:#ff6a00;display:flex;align-items:center;justify-content:center;margin-bottom:14px;}
.asvc-title{font-weight:700;color:#151d2a;font-size:17px;margin-bottom:5px;}
.asvc-sub{color:#6b7280;font-size:13px;line-height:1.4;margin-bottom:12px;min-height:36px;}
.asvc-price{color:#ff6a00;font-weight:800;font-size:18px;margin-bottom:12px;}
